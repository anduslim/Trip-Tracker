# --- App ---
APP_ENV=dev
DEBUG=true
SECRET_KEY=change-me-in-prod-please-use-32-bytes-minimum

# --- Auth / cookie ---
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=10080
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- DB ---
DATABASE_URL=sqlite+aiosqlite:///./backend/dev.db

# --- URLs ---
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Flight providers (Phase 2) ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test
AMADEUS_DEFAULT_CURRENCY=USD
SERPAPI_KEY=
DEFAULT_FLIGHT_PROVIDER=amadeus

# --- Scheduler / thresholds (Phase 2) ---
SCHEDULER_ENABLED=false
PRICE_REFRESH_INTERVAL_MINUTES=360
PRICE_CHANGE_THRESHOLD_PCT=5.0
PRICE_CHANGE_THRESHOLD_ABS=25.0

# --- Notifier (Phase 2) ---
NOTIFIER_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Frontend ---
# Used by frontend/.env.local (separate file)
VITE_API_BASE_URL=http://localhost:8000
